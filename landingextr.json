{
  "type": "object",
  "title": "Gelişmiş Hukuki Hiyerarşi Şeması (V5)",
  "description": "Nullable alanlar düzeltilmiş, hiyerarşik yapı destekli şema.",
  "required": ["law_metadata", "content_structure"],
  "properties": {
    "law_metadata": {
      "type": "object",
      "title": "Kanun Üst Bilgileri",
      "required": ["law_title", "law_number", "acceptance_date"],
      "properties": {
        "law_title": { 
          "type": "string",
          "description": "Kanun başlığı"
        },
        "law_number": { 
          "type": "string",
          "description": "Kanun numarası (örn: 6331)"
        },
        "acceptance_date": { 
          "type": "string",
          "description": "Kabul tarihi"
        },
        "publication_date": {
          "type": ["string", "null"],
          "description": "Resmi Gazete yayın tarihi"
        },
        "official_gazette": {
          "type": "object",
          "properties": {
            "date": { 
              "type": ["string", "null"]
            },
            "number": { 
              "type": ["string", "null"]
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "title": "Bölümler",
      "description": "Kanunun ana bölümleri (BİRİNCİ BÖLÜM, İKİNCİ BÖLÜM vb.)",
      "items": {
        "type": "object",
        "properties": {
          "section_title": {
            "type": ["string", "null"],
            "description": "Bölüm başlığı (örn: BİRİNCİ BÖLÜM)"
          },
          "section_heading": {
            "type": ["string", "null"],
            "description": "Bölüm açıklaması (örn: Amaç, Kapsam ve Tanımlar)"
          }
        }
      }
    },
    "definitions": {
      "type": "array",
      "description": "Kanunda geçen tanımlar",
      "items": {
        "type": "object",
        "properties": {
          "term": { 
            "type": "string",
            "description": "Tanımlanan terim"
          },
          "definition": { 
            "type": "string",
            "description": "Terimin açıklaması"
          }
        }
      }
    },
    "content_structure": {
      "type": "array",
      "title": "Hiyerarşik İçerik",
      "description": "Madde ve fıkra yapısı",
      "items": {
        "type": "object",
        "required": ["level", "index", "text_content"],
        "properties": {
          "level": {
            "type": "string",
            "enum": ["PART", "CHAPTER", "ARTICLE", "PARAGRAPH", "SUB_CLAUSE"],
            "description": "Hiyerarşi seviyesi"
          },
          "index": { 
            "type": "string", 
            "description": "Numaralandırma (Madde 1, (1), a))"
          },
          "title": { 
            "type": ["string", "null"],
            "description": "Başlık (opsiyonel)"
          },
          "text_content": { 
            "type": "string", 
            "description": "Madde metni"
          },
          "children": {
            "type": "array",
            "description": "Alt maddeler (fıkralar, bentler)",
            "items": {
              "type": "object",
              "properties": {
                "level": { 
                  "type": "string"
                },
                "index": { 
                  "type": "string"
                },
                "title": { 
                  "type": ["string", "null"]
                },
                "text_content": { 
                  "type": "string"
                },
                "cross_references": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "cross_references": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Atıflar (diğer maddelere referanslar)"
          }
        }
      }
    },
    "penalties": {
      "type": "array",
      "description": "İdari para cezaları",
      "items": {
        "type": "object",
        "properties": {
          "violated_article": { 
            "type": "string",
            "description": "İhlal edilen madde"
          },
          "penalty_amount": { 
            "type": "string",
            "description": "Ceza miktarı"
          },
          "penalty_logic": { 
            "type": ["string", "null"],
            "description": "Ceza mantığı/açıklaması"
          }
        }
      }
    },
    "amendment_summary": {
      "type": "array",
      "description": "Değişiklik özeti",
      "items": {
        "type": "object",
        "properties": {
          "effective_date": {
            "type": "string",
            "description": "Yürürlük tarihi"
          },
          "affected_articles": {
            "type": "string",
            "description": "Değişen maddeler"
          },
          "amending_law_number": {
            "type": "string",
            "description": "Değiştiren kanun numarası"
          }
        }
      }
    },
    "layout_analysis": {
      "type": "array",
      "description": "Sayfa düzeni analizi",
      "items": {
        "type": "object",
        "properties": {
          "element_type": {
            "type": "string",
            "enum": ["BODY_TEXT", "TABLE", "PAGE_NUMBER", "FOOTER", "HEADER"]
          },
          "content": { 
            "type": ["string", "null"]
          },
          "table_markdown": { 
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}