# Legislation RAG - Environment Variables

# ===== OpenRouter API =====
OPENROUTER_API_KEY=sk-or-v1-your-key-here
MODEL_NAME=google/gemini-2.5-flash-lite

# ===== Voyage AI =====
VOYAGE_API_KEY=pa-your-voyage-key-here
VOYAGE_EMBEDDING_MODEL=voyage-law-2
VOYAGE_RERANK_MODEL=rerank-2.5-lite

# ===== MongoDB =====
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true
MONGO_DB_NAME=mevzuat_db
MONGO_COLLECTION_NAME=documents
MONGO_VECTOR_INDEX_NAME=vector_index

# ===== Arize Tracing (Optional) =====
ARIZE_SPACE_ID=your-space-id
ARIZE_API_KEY=your-arize-api-key
ARIZE_PROJECT_NAME=legislationchatbot

# ===== Web Fallback - Serper.dev Search =====
SERPER_API_KEY=your-serper-api-key
SERPER_TIMEOUT=15
SERPER_MAX_RESULTS=5

# ===== Web Fallback - Azure Document Intelligence =====
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_KEY=your-azure-di-key
AZURE_DI_MODEL=prebuilt-layout

# ===== Web Fallback - TR Proxy (Optional) =====
TR_PROXY_URL=http://185.169.64.46:8080

# ===== RAG Parameters =====
CHUNK_SIZE=1500
CHUNK_OVERLAP=300
INITIAL_RETRIEVAL_K=50
TOP_RERANKED_K=15
TEMPERATURE=0.2
MAX_TOKENS=1500
HTTP_TIMEOUT=90.0
MAX_CONVERSATION_HISTORY=10
MEMORY_STRATEGY=sliding_window
